# VeriScope Environment Configuration Template
# COPY TO .env BEFORE RUNNING. NO SECRETS IN SOURCE CONTROL.

# Application Configuration
APP_NAME=VeriScope
APP_ENV=development
ASSESSMENT_DATE_DEFAULT=2026-10-26
PORT=8000
WEB_PORT=3000

# Database Configuration (SQLite default for demo; PostgreSQL for production)
DATABASE_URL=sqlite:///./veriscope.db
# DATABASE_URL=postgresql://veriscope_user:veriscope_pass@localhost:5432/veriscope

# Authentication / Security
JWT_SECRET_KEY=dev-insecure-secret-key-change-in-production-must-be-32-chars-min!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Document Storage
STORAGE_LOCAL_DIR=./storage/documents

# Connectors Configuration
MOCK_CONNECTOR_ENABLED=true
MOCK_CONNECTOR_LATENCY_MS=150

# LLM Assistance (Disabled by default - non-confidential advisory only)
LLM_PROVIDER_ENABLED=false
LLM_PROVIDER_TYPE=none
# OPENAI_API_KEY=
